{
  "build": {
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "tauri-app",
  "mainBinaryName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.tauri.app",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capability for the main window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit",
            "core:event:allow-emit-to",
            "dialog:allow-open",
            "dialog:default",
            "fs:allow-read-file",
            "fs:default"
          ]
        },
        {
          "identifier": "wallpaper-capability",
          "description": "Capability for the wallpaper window",
          "windows": [
            "wallpaper"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "fs:allow-read-file",
            "fs:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "title": "Wallpaper Engine",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "useHttpsScheme": false,
        "decorations": false
      }
    ]
  }
}
